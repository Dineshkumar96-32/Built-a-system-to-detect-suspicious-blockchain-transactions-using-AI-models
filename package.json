{
  "name": "blockshield-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root management for BlockShield Blockchain Fraud Detection system",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix frontend && pip install -r requirements.txt",
    "backend:dev": "python -m uvicorn app.main:app --reload --port 8000",
    "all": "concurrently \"npm run backend:dev\" \"npm run dev\"",
    "test": "python -m pytest tests/",
    "lint": "ruff check app/ tests/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
