# ═══════════════════════════════════════════════════════════════
# BlockShield — Backend Environment Variables
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_NAME=BlockShield
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false          # true = structured JSON logs (production)
WORKERS=4               # uvicorn worker count

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://bs:blockshield@localhost:5432/blockshield
# SQLite (local dev — no setup required):
# DATABASE_URL=sqlite+aiosqlite:///./blockshield.db

DB_ECHO=false           # true = log all SQL (verbose, dev only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=bs
POSTGRES_PASSWORD=blockshield
POSTGRES_DB=blockshield

# ── Auth / JWT ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_H=24

# Legacy static API key(s) — comma-separated
API_KEYS=your-static-api-key-here

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
RATE_LIMIT_RPM=60       # requests per minute per API key

# ── Broker ───────────────────────────────────────────────────
# Options: memory | redis | kafka
BROKER_BACKEND=redis

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=blockshield-consumers
KAFKA_AUTO_OFFSET_RESET=latest

# ── ML / Models ───────────────────────────────────────────────
MODEL_DIR=models
RETRAIN_THRESHOLD=50    # new analyst labels before triggering retrain
RETRAIN_INTERVAL_SEC=3600
MAX_TRAINING_ROWS=100000
FLAG_THRESHOLD=0.6      # anomaly_score threshold for flagging a tx
GNN_MODEL_PATH=models/wallet_gnn.pt
OFAC_SDN_CSV=data/sdn_advanced.csv

# ── Chain RPC ─────────────────────────────────────────────────
# Enabled chains (comma-separated)
ENABLED_CHAINS=ethereum,polygon

# Ethereum
ETH_ALCHEMY_KEY=-Lbzo04uBHVhuei1ZoKmA
ETH_INFURA_KEY=820a360b888243dda5f434198074d9b2
ETH_RPC_URL=ETH_RPC_URL=https://alchemy.com forge script script/Deploy.s.sol --broadcast)

# Polygon
POLYGON_ALCHEMY_KEY=bjWnEfH0EcO--Iw7kEgC2
POLYGON_RPC_URL= https://rpc-amoy.polygon.technology

# BSC (no Alchemy/Infura — uses public RPC by default)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Arbitrum
ARBITRUM_ALCHEMY_KEY=yGKzYO3sCb0pIOYI7mPRl

# ── Frontend CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Observability ─────────────────────────────────────────────
# Grafana
GRAFANA_PASSWORD=blockshield_admin

# SMTP (for Alertmanager)
SMTP_PASSWORD=DINESH@9632
