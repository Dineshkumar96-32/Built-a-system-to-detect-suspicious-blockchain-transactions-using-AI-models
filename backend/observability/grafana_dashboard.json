{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "version": "" },
    { "type": "panel", "id": "gauge", "version": "" },
    { "type": "panel", "id": "stat", "version": "" },
    { "type": "panel", "id": "heatmap", "version": "" }
  ],
  "title": "BlockShield — Pipeline & ML Observability",
  "uid": "blockshield-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["blockshield", "blockchain", "fraud-detection"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Transactions Processed (total)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum(blockshield_tx_processed_total)", "legendFormat": "Total" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":100000},{"color":"red","value":1000000}] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Anomalies Flagged (total)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum(blockshield_tx_flagged_anomaly_total)", "legendFormat": "Anomalies" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"orange","value":50},{"color":"red","value":500}] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Model Version (IF)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "blockshield_isolation_forest_version", "legendFormat": "Version" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4, "type": "stat", "title": "Rate-Limited Requests",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum(rate(blockshield_rate_limit_hits_total[5m])) * 60", "legendFormat": "RPM blocked" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":10}] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Analyst Feedback Labels",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum(blockshield_feedback_labels_total)", "legendFormat": "Labels" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 6, "type": "stat", "title": "Retrain Events",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum(blockshield_retrain_events_total)", "legendFormat": "Retrains" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 10, "type": "timeseries", "title": "Transaction Throughput by Chain",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum by (chain)(rate(blockshield_tx_processed_total[1m])) * 60", "legendFormat": "{{chain}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Anomaly Flag Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [
        { "expr": "sum by (model)(rate(blockshield_tx_flagged_anomaly_total[5m])) * 60", "legendFormat": "{{model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 20, "type": "timeseries", "title": "RPC Latency (p50 / p95 / p99) — Ethereum",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le)(rate(blockshield_rpc_latency_seconds_bucket{chain='ethereum'}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le)(rate(blockshield_rpc_latency_seconds_bucket{chain='ethereum'}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(blockshield_rpc_latency_seconds_bucket{chain='ethereum'}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "HTTP Request Duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint)(rate(blockshield_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 30, "type": "heatmap", "title": "Anomaly Score Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "sum by (le)(rate(blockshield_anomaly_score_bucket[5m]))", "format": "heatmap", "legendFormat": "{{le}}" }],
      "options": { "calculate": false, "color": { "scheme": "Oranges", "mode": "scheme" } }
    },
    {
      "id": 31, "type": "timeseries", "title": "Broker Queue Depth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "blockshield_broker_queue_depth", "legendFormat": "{{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 40, "type": "timeseries", "title": "Latest Block by Chain",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": "$DS_PROMETHEUS",
      "targets": [{ "expr": "blockshield_latest_block", "legendFormat": "{{chain}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
